
import cv2
import numpy as np
import os
from datetime import datetime

# --------------------------------
# ARCHIVOS
# --------------------------------

ARCHIVOS = [
    "input_02.jpeg",
    "input_03.jpeg"
]

# --------------------------------
# PARÁMETROS
# --------------------------------

TAM_PARCHE = 422          # tamaño de cada fragmento
TOP_K = 55                # elige entre los K parches más parecidos
DIST_MIN_PARCHES = 4     # evita reemplazar por parches demasiado cercanos
USAR_COLOR = True        # True = usa color; False = solo gris

# --------------------------------
# NOMBRE ÚNICO
# --------------------------------

def nombre_salida_unico(input_path):
    nombre_base = os.path.splitext(os.path.basename(input_path))[0]
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
    return f"{nombre_base}_parches_erroneos_{timestamp}.jpg"

# --------------------------------
# DESCRIPTOR DEL PARCHE
# --------------------------------

def descriptor_parche(parche, usar_color=True):
    if usar_color:
        # promedio + desviación en color
        media = parche.mean(axis=(0, 1))
        std = parche.std(axis=(0, 1))

        # miniatura pequeña para capturar estructura general
        mini = cv2.resize(parche, (4, 4), interpolation=cv2.INTER_AREA)
        mini = mini.astype(np.float32).flatten()

        desc = np.concatenate([media, std, mini])
    else:
        gris = cv2.cvtColor(parche, cv2.COLOR_BGR2GRAY)
        media = np.array([gris.mean()])
        std = np.array([gris.std()])

        mini = cv2.resize(gris, (4, 4), interpolation=cv2.INTER_AREA)
        mini = mini.astype(np.float32).flatten()

        desc = np.concatenate([media, std, mini])

    return desc.astype(np.float32)

# --------------------------------
# EXTRAER PARCHES
# --------------------------------

def extraer_patches(img, tam_parche, usar_color=True):
    h, w = img.shape[:2]

    # recortar para que encaje exacto en la grilla
    h2 = h - (h % tam_parche)
    w2 = w - (w % tam_parche)
    img_rec = img[:h2, :w2].copy()

    patches = []
    posiciones = []
    descriptores = []

    for y in range(0, h2, tam_parche):
        for x in range(0, w2, tam_parche):
            parche = img_rec[y:y+tam_parche, x:x+tam_parche]
            patches.append(parche)
            posiciones.append((x, y))
            descriptores.append(descriptor_parche(parche, usar_color))

    return img_rec, patches, posiciones, np.array(descriptores, dtype=np.float32)

# --------------------------------
# RECONSTRUIR POR PARCHES ERRÓNEOS
# --------------------------------

def reconstruir_por_patches_erroneos(img, tam_parche, top_k, dist_min_patches, usar_color):
    img_rec, patches, posiciones, descriptores = extraer_patches(
        img,
        tam_parche,
        usar_color
    )

    h, w = img_rec.shape[:2]
    salida = np.zeros_like(img_rec)

    n = len(patches)

    for i in range(n):
        desc_i = descriptores[i]
        xi, yi = posiciones[i]

        # distancia visual entre este parche y todos los demás
        dists = np.linalg.norm(descriptores - desc_i, axis=1)

        candidatos = []

        for j in range(n):
            if i == j:
                continue

            xj, yj = posiciones[j]

            # distancia en unidades de parches
            dx = abs((xj - xi) // tam_parche)
            dy = abs((yj - yi) // tam_parche)

            # evitar reemplazos demasiado cercanos
            if dx < dist_min_patches and dy < dist_min_patches:
                continue

            candidatos.append((j, dists[j]))

        if len(candidatos) == 0:
            elegido = i
        else:
            candidatos = sorted(candidatos, key=lambda t: t[1])

            top = candidatos[:min(top_k, len(candidatos))]
            elegido = np.random.choice([t[0] for t in top])

        parche_reemplazo = patches[elegido]
        salida[yi:yi+tam_parche, xi:xi+tam_parche] = parche_reemplazo

    return salida

# --------------------------------
# PROCESAR ARCHIVOS
# --------------------------------

for INPUT in ARCHIVOS:
    img = cv2.imread(INPUT)

    if img is None:
        print(f"No encontré el archivo: {INPUT}")
        continue

    resultado = reconstruir_por_patches_erroneos(
        img,
        TAM_PARCHE,
        TOP_K,
        DIST_MIN_PARCHES,
        USAR_COLOR
    )

    OUTPUT = nombre_salida_unico(INPUT)
    cv2.imwrite(OUTPUT, resultado)

    print("Imagen creada:")
    print(OUTPUT)
